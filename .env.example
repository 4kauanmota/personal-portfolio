# Copie para .env e preencha. O arquivo .env nunca vai para o Git.

# Token do GitHub usado SÓ no build/sincronização (nunca chega ao navegador).
# Sem token a API permite 60 requisições por hora por IP; com token, 5.000.
# Crie um "fine-grained token" sem nenhuma permissão extra (acesso só a repositórios públicos):
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Endereço público do site, usado nas tags canônicas e de compartilhamento.
# Na Vercel ele é detectado sozinho pelo domínio de produção.
SITE_URL=https://4kauanmota.vercel.app
